# Salin ke `.env` dan isi nilainya: `cp .env.example .env`
# Semua var dibaca fail-fast saat startup (docs/05 §2).

# ===== wajib =====
DATABASE_URL=postgres://app:dev@localhost:5432/transcribe
# Generasi: `openssl rand -base64 48` — MIN 32 byte, wajib diganti di produksi.
JWT_SECRET=
# https://console.groq.com/keys (gratis)
GROQ_API_KEY=

# ===== optional (default di kurung) =====
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
# json | text (LOG_FORMAT)
LOG_FORMAT=text

# Auth
ACCESS_TOKEN_TTL_SECS=900
REFRESH_TOKEN_TTL_SECS=2592000
# true di produksi (TLS dihentikan proxy) — juga mengaktifkan header HSTS.
COOKIE_SECURE=false

# Beta tertutup: isi kode undangan untuk mewajibkannya saat register.
# Kosongkan / hapus = pendaftaran terbuka.
BETA_INVITE_CODE=

# Storage: `local` (dev) atau `s3` (S3/MinIO/R2 — aktif otomatis bila S3_* terisi)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./tmp/storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# Upload
MAX_UPLOAD_BYTES=209715200

# Media tools (di container sudah terpasang)
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg

# Worker & Groq
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=2000
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MAX_RETRIES=3
GROQ_RETRY_BASE_MS=500
# 25 MB = batas multipart Groq; di atas ini file dipotong per GROQ_CHUNK_SECONDS.
GROQ_CHUNK_BYTES=26214400
GROQ_CHUNK_SECONDS=600

# Retensi audio (hari) setelah job selesai.
AUDIO_RETENTION_DAYS=30
