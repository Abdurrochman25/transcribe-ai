# Salin menjadi `.env` di root repo — docker-compose membacanya otomatis.

# Kunci API Groq (https://console.groq.com/keys).
# Kosong OK untuk Fase 0; WAJIB mulai Fase 3 (worker transkripsi).
GROQ_API_KEY=

# Secret untuk menandatangani JWT sesi.
# WAJIB minimal 32 byte. Untuk produksi: `openssl rand -base64 48`.
JWT_SECRET=dev-secret-ganti-dengan-acak-minimal-32-byte!

# Contoh koneksi database saat `cargo run` lokal tanpa Docker
# (postgres dari `docker compose up -d postgres`):
# DATABASE_URL=postgres://app:dev@localhost:5432/transcribe
