# Salin menjadi `.env` di root repo — docker-compose membacanya otomatis.

# Kunci API Groq (https://console.groq.com/keys).
# Kosong OK untuk Fase 0-2; WAJIB mulai Fase 3 (worker transkripsi).
GROQ_API_KEY=

# Secret untuk menandatangani JWT sesi.
# WAJIB minimal 32 byte. Untuk produksi: `openssl rand -base64 48`.
JWT_SECRET=dev-secret-ganti-dengan-acak-minimal-32-byte!

# ===== Object storage =====
# s3   → S3/MinIO/R2 (butuh S3_ENDPOINT + S3_BUCKET + kredensial)
# local → filesystem (dev ringan tanpa MinIO; file di STORAGE_LOCAL_ROOT)
# STORAGE_DRIVER=local
# STORAGE_LOCAL_ROOT=tmp/storage
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=audio
# S3_ACCESS_KEY=dev
# S3_SECRET_KEY=devdevdev

# Contoh koneksi database saat `cargo run` lokal tanpa Docker
# (postgres dari `podman compose up -d postgres`):
# DATABASE_URL=postgres://app:dev@localhost:5432/transcribe
